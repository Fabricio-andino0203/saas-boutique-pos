// Esquema de la base CENTRAL (plano de control) del SaaS. Fuente: docs/SAAS_PROPUESTA.md §3.1.
//
// Aquí viven los negocios (tenants), los superadministradores de la plataforma y su auditoría. NUNCA guarda ventas,
// inventario ni clientes: eso está en la base de cada negocio (prisma/schema.prisma).
//
// Convenciones:
//  - Nada con historial se borra: los negocios y los superadministradores se desactivan o cambian de estado.
//  - Los secretos (contraseña de la base de un negocio, secreto del 2FA) se guardan cifrados por la bóveda
//    (src/lib/tenancy/vault.ts), nunca en claro. Las columnas terminadas en `Enc` contienen el sobre cifrado.
//  - Las restricciones que Prisma no puede expresar (auditoría de solo inserción) viven en la migración `constraints`.
//  - El alta automática, la migración de la flota y la baja controlada son de la Etapa 3; los planes, suscripciones y pagos
//    (con sus restricciones en la migración `plans_and_subscriptions`) de la Etapa 4.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/control"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum TenantStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED
  FAILED
  /// La última actualización de su base falló: se muestra «en mantenimiento» hasta repararla (los demás siguen).
  MIGRATION_FAILED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  /// Fila vieja, reemplazada por otra (un cambio de plan): queda como historial.
  EXPIRED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

enum ProvisioningStatus {
  RUNNING
  SUCCEEDED
  FAILED
  /// Se deshizo lo creado por el intento (base y rol).
  UNDONE
}

// ───────────────────────────── Negocios ─────────────────────────────

model Tenant {
  id     String       @id @default(cuid())
  /// Subdominio único del negocio (`tienda-a` → tienda-a.<dominio>).
  slug   String       @unique
  name   String
  status TenantStatus @default(PROVISIONING)

  ownerEmail String?

  /// Servidor de Postgres donde vive su base (hoy solo existe "primary").
  dbServerId      String  @default("primary")
  /// Nombres generados por el sistema, nunca escritos por una persona.
  dbName          String? @unique
  dbRole          String? @unique
  /// Contraseña del rol de la base del negocio, cifrada por la bóveda.
  dbCredentialEnc String?

  /// Última migración aplicada a la base del negocio.
  schemaVersion String?

  /// Se migra primero en cada actualización; si falla, no se toca al resto de la flota.
  canary Boolean @default(false)
  /// Por qué falló su última migración (nulo si va al día).
  migrationError    String?
  migrationFailedAt DateTime?

  /// Baja controlada: pendiente de eliminar hasta `deleteAfter`; luego se archiva (la base se renombra, no se destruye).
  deletionRequestedAt  DateTime?
  deleteAfter          DateTime?
  deletionReason       String?
  /// En qué estado estaba al pedir la baja, para volver a él si se cancela.
  statusBeforeDeletion TenantStatus?
  archivedAt           DateTime?
  archivedDbName       String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provisioningRuns ProvisioningRun[]
  subscriptions    Subscription[]
  payments         PlatformPayment[]

  @@index([status])
}

// ───────────────────────────── Planes, suscripciones y pagos (Etapa 4) ─────────────────────────────

/// Lo que se vende: un precio, una duración, los módulos que incluye y cuánto se puede crear.
model Plan {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  priceCents  Int
  interval    BillingInterval @default(MONTHLY)
  /// { users?, products?, terminals?, locations? }: enteros; ausente o null = sin límite.
  limits      Json            @default("{}")
  /// Módulos incluidos (ver src/config/plan-catalog.ts). El núcleo va siempre.
  features    String[]
  /// Días de prueba de un negocio nuevo con este plan.
  trialDays   Int             @default(14)
  /// Un plan desactivado ya no se ofrece, pero los negocios que lo tienen lo conservan.
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([isActive, sortOrder])
}

/// El contrato de un negocio con un plan. Un cambio de plan **no edita** la fila: cierra la vigente (EXPIRED) y crea otra, así
/// que el historial de qué tuvo contratado y a qué precio nunca se reescribe. Solo hay una vigente por negocio.
model Subscription {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  planId   String
  plan     Plan   @relation(fields: [planId], references: [id])

  /// Último estado anotado (lo deja el barrido diario); el que manda en cada consulta se calcula con las fechas.
  status SubscriptionStatus
  /// Prueba gratuita: sigue siéndolo hasta el primer pago, aunque ya haya vencido.
  isTrial Boolean @default(false)

  startsAt           DateTime
  currentPeriodStart DateTime
  /// Hasta cuándo está pagado (o en prueba). De aquí salen la gracia, el solo lectura y la cancelación.
  currentPeriodEnd   DateTime

  /// Días con todo funcionando después del vencimiento, y días de solo lectura antes de cancelar.
  graceDays    Int @default(7)
  readOnlyDays Int @default(60)

  /// Lo acordado al contratar: no cambia si después se edita el plan.
  priceCentsSnapshot Int
  intervalSnapshot   BillingInterval

  /// Plan que empieza en la próxima renovación (cambio «al fin del periodo»).
  nextPlanId String?
  reason     String?
  endedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments PlatformPayment[]

  @@index([tenantId, startsAt])
  @@index([status, currentPeriodEnd])
}

/// Un pago registrado a mano (la v1 no cobra sola). Es de solo inserción (lo garantiza un trigger): un error se corrige
/// ajustando el vencimiento con su motivo en la auditoría, nunca editando el pago.
model PlatformPayment {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  amountCents Int
  method      PaymentMethod
  reference   String?
  note        String?
  paidAt      DateTime
  /// El tramo de tiempo que este pago cubre.
  coversFrom  DateTime
  coversUntil DateTime

  registeredById       String?
  registeredByUsername String?
  createdAt            DateTime @default(now())

  @@index([tenantId, paidAt])
}

/// Un intento de dar de alta un negocio: cada paso queda anotado para poder reintentar desde donde falló o deshacerlo.
model ProvisioningRun {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  status  ProvisioningStatus @default(RUNNING)
  attempt Int                @default(1)
  /// [{ name, status: PENDING | DONE | FAILED, startedAt?, finishedAt?, error? }]
  steps   Json
  error   String?

  /// Datos del propietario inicial. La contraseña temporal va cifrada por la bóveda y se borra al terminar.
  ownerName     String
  ownerUsername String
  ownerEmail    String?
  secretEnc     String?
  /// Plan con el que arranca el negocio (en prueba); se aplica al terminar el alta. Nulo = sin plan.
  planId        String?

  actorId       String?
  actorUsername String?

  /// Último signo de vida: una ejecución «en marcha» sin él por varios minutos se considera interrumpida.
  heartbeatAt DateTime  @default(now())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([tenantId, startedAt])
  @@index([status])
}

// ───────────────────────────── Superadministradores ─────────────────────────────

model PlatformUser {
  id           String @id @default(cuid())
  username     String @unique
  name         String
  passwordHash String

  /// Secreto TOTP cifrado por la bóveda. Existe desde que empieza el alta del 2FA.
  totpSecretEnc String?
  /// Cuándo se confirmó el 2FA con un primer código. Sin esto, el usuario aún no puede entrar al panel.
  totpEnabledAt DateTime?
  /// Último intervalo de 30 s aceptado: un código ya usado no se acepta de nuevo (anti-repetición).
  totpLastStep  Int?

  isActive     Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions PlatformSession[]
}

model PlatformSession {
  id           String       @id @default(cuid())
  /// Hash SHA-256 del token de la cookie; el token en claro nunca se guarda.
  sessionToken String       @unique
  userId       String
  user         PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  expires DateTime
  /// Nulo mientras la sesión solo pasó la contraseña: no da acceso al panel hasta confirmar el 2FA.
  mfaVerifiedAt DateTime?

  ip        String?
  userAgent String?

  createdAt DateTime @default(now())
  /// Última actividad (para el cierre por inactividad).
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expires])
}

// ───────────────────────────── Auditoría ─────────────────────────────

/// Registro de toda acción administrativa de la plataforma. Es de solo inserción (lo garantiza un trigger en la migración).
model PlatformAuditLog {
  id String   @id @default(cuid())
  at DateTime @default(now())

  /// Quién actuó. Nulo cuando lo hizo el sistema o cuando falló un inicio de sesión de un usuario inexistente.
  actorId       String?
  /// Copia del usuario al momento de actuar: sobrevive aunque el usuario se desactive.
  actorUsername String?

  /// Código estable de la acción (p. ej. PLATFORM_LOGIN). Ver src/modules/platform/audit.ts.
  action String

  tenantId   String?
  targetType String?
  targetId   String?

  /// Datos de apoyo de la acción. Nunca contraseñas, códigos ni secretos.
  details Json?
  ip      String?

  @@index([at])
  @@index([action, at])
  @@index([actorId, at])
  @@index([tenantId, at])
}
