# Copiar a .env y completar. Nunca versionar .env

NODE_ENV=development
APP_URL=http://localhost:3000
TZ=America/Tegucigalpa

# Postgres local (docker compose). Solo para desarrollo.
POSTGRES_USER=boutique
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=boutique_pos
POSTGRES_PORT=5432

# Debe coincidir con los valores de arriba.
DATABASE_URL=postgresql://boutique:change-me-local-only@localhost:5432/boutique_pos?schema=public

# Mínimo 32 caracteres. Generar uno propio: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-random-secret-of-32-chars-or-more

# BD de pruebas de integración (la crea docker/postgres/init). Debe terminar en _test.
DATABASE_URL_TEST=postgresql://boutique:change-me-local-only@localhost:5432/boutique_pos_test?schema=public

# ── Plataforma SaaS (opcional; ver docs/SAAS_PROPUESTA.md, docs/SAAS_ETAPA_1.md y docs/SAAS_ETAPA_2.md) ──
# El panel del superadministrador y los negocios por subdominio solo existen con TENANCY_MODE=multi.
# Sin estas variables el sistema funciona exactamente como siempre: una sola tienda con DATABASE_URL.
# TENANCY_MODE=multi
# PLATFORM_HOST=admin.localhost
# Los negocios se atienden en <subdominio>.<TENANT_BASE_DOMAIN> (en local, tienda.localhost:3000; Chromium lo resuelve solo).
# Registra la tienda de DATABASE_URL como el negocio #1 con: pnpm platform:adopt-store --slug tienda --name "Mi tienda"
# TENANT_BASE_DOMAIN=localhost
# Cuenta de Postgres que crea y migra las bases de los negocios nuevos (alta automática; ver docs/SAAS_ETAPA_3.md).
# TENANT_PROVISIONING_URL=postgresql://boutique:change-me-local-only@localhost:5432/postgres
# TENANT_TEMPLATE_DB=boutique_plantilla
# Base central (negocios, superadministradores, auditoría). Créala y migrala con: pnpm control:setup
# CONTROL_DATABASE_URL=postgresql://boutique:change-me-local-only@localhost:5432/boutique_pos_control?schema=public
# Llave que cifra los secretos de la plataforma. Genera una con: pnpm platform:gen-key
# y respáldala FUERA del servidor (sin ella no se recuperan). No uses la de otro entorno.
# PLATFORM_MASTER_KEY=
# Pruebas de integración de la plataforma (si falta se deriva de DATABASE_URL_TEST). Debe terminar en _test.
# CONTROL_DATABASE_URL_TEST=postgresql://boutique:change-me-local-only@localhost:5432/boutique_pos_control_test?schema=public
